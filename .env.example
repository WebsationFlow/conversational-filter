# ConversationalFilter Configuration

# Lemonsqueezy (Recommended for billing)
LEMONSQUEEZY_API_KEY=your_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe (Alternative, if using Stripe instead)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Mailgun (For email notifications)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mail.conversational-filter.io

# Email Configuration
FROM_EMAIL=hello@conversational-filter.io
SUPPORT_EMAIL=support@conversational-filter.io
ADMIN_EMAIL=admin@conversational-filter.io

# API Configuration
PORT=5000
DEBUG=false
SECRET_KEY=change_me_to_random_string

# Database (Optional, for storing metrics)
# DATABASE_URL=postgresql://user:password@localhost/conversational_filter

# Analytics
ANALYTICS_ENABLED=true
METRICS_FILE=metrics.jsonl

# License Configuration
LICENSE_CHECK_INTERVAL=3600  # seconds
LICENSE_CACHE_TTL=86400     # seconds

# Payout Configuration (Lemonsqueezy handles this, but track it)
MONTHLY_PAYOUT_REMINDER=true
PAYOUT_EMAIL=your-connected-email@example.com

# GitHub Integration (Optional, for auto-releases)
GITHUB_TOKEN=your_github_token
GITHUB_REPO=rayne-ai/conversational-filter

# Sentry (Error tracking, optional)
# SENTRY_DSN=your_sentry_dsn

# Rate Limiting (API)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
